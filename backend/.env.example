PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=<clustername>
JWT_SECRET=your_jwt_secret_key_here
# Set to "production" so the backend serves frontend/dist as static files
NODE_ENV=development

# AI Evaluation - OpenAI API Key (optional, falls back to heuristic scoring)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Email Notifications (optional — falls back to Ethereal test account if unset)
# For production, use a real SMTP service like Gmail, SendGrid, or Mailgun:
# Gmail: host=smtp.gmail.com, port=587, user=<your-email>, pass=<app-password>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@online-examination-sou.com

# SMS Notifications via Fast2SMS (optional — skipped if unset)
# Get your key at: https://www.fast2sms.com
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_SENDER_ID=SOUEXM

# Frontend URL used in result-emails ("View Full Results" button)
FRONTEND_URL=https://online-examination-sou.pages.dev
