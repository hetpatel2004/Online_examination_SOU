PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=<clustername>
JWT_SECRET=your_jwt_secret_key_here
# Set to "production" so the backend serves frontend/dist as static files
NODE_ENV=development

# AI Evaluation - OpenAI API Key (optional, falls back to heuristic scoring)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Email Notifications (optional — falls back to Ethereal test account if unset)
# For production, use a real SMTP service like Gmail, SendGrid, or Mailgun:
# Gmail: host=smtp.gmail.com, port=587, user=<your-email>, pass=<app-password>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@online-examination-sou.com

# HTTPS Email API via Gmail (RECOMMENDED — works on Render over port 443 and can
# email ANY recipient without owning a domain). Render's free tier blocks SMTP.
# 1) Set up Google Cloud (see backend/scripts/gmail-oauth.js for full steps):
#    enable Gmail API, configure OAuth consent screen (External, add the SENDING
#    account as a test user), create an OAuth Client ID (type: Desktop app).
# 2) Run `node scripts/gmail-oauth.js` to generate GOOGLE_REFRESH_TOKEN.
# 3) GOOGLE_USER_EMAIL = the Gmail account that sends (must match the account
#    used during OAuth). When configured, Gmail API is used before Resend.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REFRESH_TOKEN=your_refresh_token
GOOGLE_USER_EMAIL=your_sending_account@gmail.com

# HTTPS Email API via Resend (free, 100 emails/day) — falls back to this if the
# Gmail API above is not configured. Sign up at https://resend.com, key at
# https://resend.com/api-keys. RESEND_FROM defaults to onboarding@resend.dev,
# which only delivers to your own inbox — verify a domain to email other people.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=SOU Examination <onboarding@resend.dev>

# SMS Notifications via Fast2SMS (optional — skipped if unset)
# Get your key at: https://www.fast2sms.com
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_SENDER_ID=SOUEXM

# Frontend URL used in result-emails ("View Full Results" button)
FRONTEND_URL=https://online-examination-sou.pages.dev
